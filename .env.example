# Supabase (use the service-role / secret key: RLS blocks the anon key)
SUPABASE_URL=...
SUPABASE_KEY=...

# MASTER PASSWORD
MASTER_PASSWORD=...

# Session tokens (random, e.g. `openssl rand -base64 32`)
SESSION_SECRET=...

# Vercel cron authentication
CRON_SECRET=...

# Email
SMTP_USER=...
SMTP_PASS=...

# Geoapify
GEOAPIFY_API_KEY=...
